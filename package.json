{
  "name": "imonpro",
  "version": "0.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "vite",
    "electron:dev": "node scripts/electron-dev.cjs",
    "electron:build": "npm run build && node scripts/electron-build.cjs",
    "electron:start": "npm run build && electron .",
    "preview": "vite preview",
    "type-check": "vue-tsc --build"
  },
  "build": {
    "appId": "pro.imon.desktop",
    "productName": "Imon PRO",
    "directories": {
      "buildResources": "assets",
      "output": "release-electron-rolefix"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@vue/language-plugin-pug": "^2.1.10",
    "axios": "^1.7.9",
    "capacitor-plugin-safe-area": "^3.0.4",
    "chart.js": "^4.5.1",
    "pinia": "^2.2.6",
    "register-service-worker": "^1.7.2",
    "swiper": "^12.1.3",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.3",
    "vue-pug-plugin": "^2.0.3",
    "vue-router": "^4.4.5",
    "vue3-easy-data-table": "^1.5.47",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/cli-plugin-pwa": "~5.0.0",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.15.2",
    "npm-run-all2": "^7.0.1",
    "png-to-ico": "^3.0.1",
    "sass": "^1.82.0",
    "sass-loader": "^16.0.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-vue-devtools": "^7.6.5",
    "vue-tsc": "^2.1.10"
  },
  "type": "module"
}

